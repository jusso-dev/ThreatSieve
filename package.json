{
  "name": "threatsieve",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm db:migrate && turbo dev",
    "build": "turbo build",
    "typecheck": "tsc --noEmit && tsc -p tests/system/tsconfig.json && pnpm --filter @threatsieve/web typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "eval": "tsx scripts/evaluate.ts",
    "db:migrate": "wrangler d1 migrations apply threatsieve --local",
    "seed": "tsx scripts/seed.ts",
    "deploy": "tsx scripts/deploy.ts",
    "cli": "tsx scripts/cli.ts",
    "cf:types": "wrangler types",
    "format": "prettier --write .",
    "bootstrap": "pnpm db:migrate && pnpm seed",
    "tenant:create": "tsx scripts/tenant.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "security": "tsx scripts/security-check.ts",
    "db:validate": "vitest run tests/integration.test.ts",
    "test:playwright": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@e2e-dev/web": "0.12.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "e2e": "0.17.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "latest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "zod": "^4.1.0"
  }
}
