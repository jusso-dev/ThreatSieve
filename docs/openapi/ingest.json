{
  "openapi": "3.1.0",
  "info": {
    "title": "ThreatSieve ingest API",
    "version": "1.0.0",
    "description": "Accepts structured security alerts and advisories as native JSON, STIX 2.1, CSAF 2.0 or OSV, maps them to one schema and stores them per tenant. Bodies are limited to 5 MiB and 500 items. Through the web app the same routes are served under /api."
  },
  "servers": [
    {
      "url": "/",
      "description": "API Worker"
    },
    {
      "url": "/api",
      "description": "Web proxy"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/ingest": {
      "post": {
        "operationId": "ingest",
        "summary": "Submit one alert or advisory, or a batch",
        "description": "The format comes from Content-Type, or from the `format` field of an `application/json` envelope. A single document is stored synchronously (201 created, 200 when it matched an existing item). Arrays, envelopes and STIX bundles are batches: valid items are queued (202) and invalid ones are reported per item. Requires scope `ingest:write`.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Repeat the key with the same body to receive the first response again; a different body returns 409."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/NativeItem"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/NativeItem"
                    }
                  },
                  {
                    "$ref": "#/components/schemas/IngestEnvelope"
                  }
                ]
              }
            },
            "application/vnd.threatsieve.ingest+json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/NativeItem"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "$ref": "#/components/schemas/NativeItem"
                    }
                  },
                  {
                    "$ref": "#/components/schemas/IngestEnvelope"
                  }
                ]
              }
            },
            "application/stix+json": {
              "schema": {
                "type": "object",
                "description": "A STIX 2.1 bundle.",
                "required": ["type", "id", "objects"]
              }
            },
            "application/vnd.oasis.stix+json": {
              "schema": {
                "type": "object",
                "description": "A STIX 2.1 bundle.",
                "required": ["type", "id", "objects"]
              }
            },
            "application/csaf+json": {
              "schema": {
                "description": "A CSAF 2.0 document, or an array of them.",
                "oneOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                ]
              }
            },
            "application/vnd.oasis.csaf+json": {
              "schema": {
                "description": "A CSAF 2.0 document, or an array of them.",
                "oneOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                ]
              }
            },
            "application/osv+json": {
              "schema": {
                "description": "An OSV record, or an array of them.",
                "oneOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                ]
              }
            },
            "application/vnd.osv+json": {
              "schema": {
                "description": "An OSV record, or an array of them.",
                "oneOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The item matched an existing one (same source and external ID) and was updated or left unchanged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredResult"
                }
              }
            }
          },
          "201": {
            "description": "The item was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredResult"
                }
              }
            }
          },
          "202": {
            "description": "Batch accepted for asynchronous storage.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or no item passed validation (`error.items` lists issues per item).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope `ingest:write`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with a different body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body or item count over the limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Content-Type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest/{id}": {
      "get": {
        "operationId": "getIngested",
        "summary": "Fetch a stored item (ing_…) or a batch's status (inb_…)",
        "description": "Requires scope `ingest:read`. Only the submitting tenant can read an item.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(ing|inb)_[a-f0-9]{32,40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The item with its normalisation record and raw payload, or the batch status.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StoredItem"
                    },
                    {
                      "$ref": "#/components/schemas/BatchStatus"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found in this tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest/metrics": {
      "get": {
        "operationId": "ingestMetrics",
        "summary": "Daily item counters for this tenant",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Counters per UTC day.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A ThreatSieve API key."
      }
    },
    "schemas": {
      "NativeItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["alert", "advisory"]
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "summary": {
            "type": "string",
            "maxLength": 65536
          },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "vendor_severity": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              },
              "vendor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "cve_ids": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CVE-\\d{4}-\\d{4,}$"
            }
          },
          "cvss": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "enum": ["2.0", "3.0", "3.1", "4.0"]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "vector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": ["version"],
            "additionalProperties": false
          },
          "affected_products": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "vendor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "product": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "versions": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "introduced": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "fixed": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "last_affected": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "limit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "range": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "cpe": {
                  "type": "string",
                  "maxLength": 500,
                  "pattern": "^cpe:(?:2\\.3:[aho*-]:|\\/[aho]:)\\S*$"
                },
                "purl": {
                  "type": "string",
                  "maxLength": 1000,
                  "pattern": "^pkg:[A-Za-z.+-][A-Za-z0-9.+-]*\\/\\S+$"
                }
              },
              "required": ["product"],
              "additionalProperties": false
            }
          },
          "indicators": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "ipv4",
                    "ipv6",
                    "cidr",
                    "domain",
                    "url",
                    "email",
                    "md5",
                    "sha1",
                    "sha256"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "confidence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": ["type", "value"],
              "additionalProperties": false
            }
          },
          "attack_techniques": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T\\d{4}(?:\\.\\d{3})?$"
            }
          },
          "references": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": ["url"],
              "additionalProperties": false
            }
          },
          "tags": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "tlp": {
            "type": "string",
            "enum": ["clear", "white", "green", "amber", "amber+strict", "red"]
          },
          "raw": {}
        },
        "required": ["type", "title", "source"],
        "additionalProperties": false
      },
      "IngestEnvelope": {
        "type": "object",
        "properties": {
          "format": {
            "default": "native",
            "type": "string",
            "enum": ["native", "stix", "csaf", "osv"]
          },
          "default_tlp": {
            "type": "string",
            "enum": ["clear", "white", "green", "amber", "amber+strict", "red"]
          },
          "items": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {}
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "NormalisedItem": {
        "type": "object",
        "description": "An item after mapping and normalisation.",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["alert", "advisory"]
          },
          "format": {
            "type": "string",
            "enum": ["native", "stix", "csaf", "osv"]
          },
          "external_id": {
            "type": "string"
          },
          "external_id_source": {
            "type": "string",
            "enum": ["provided", "derived"]
          },
          "title": {
            "type": "string",
            "description": "Plain text; markup and invisible characters removed."
          },
          "summary": {
            "type": ["string", "null"]
          },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "severity_source": {
            "type": "string",
            "enum": ["provided", "vendor", "cvss", "default"]
          },
          "vendor_severity": {
            "type": ["string", "number", "null"],
            "description": "The producer's value, unchanged."
          },
          "source": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": ["string", "null"]
              },
              "vendor": {
                "type": ["string", "null"]
              }
            }
          },
          "published_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "cve_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cvss": {
            "type": ["object", "null"],
            "properties": {
              "version": {
                "type": "string"
              },
              "score": {
                "type": ["number", "null"]
              },
              "vector": {
                "type": ["string", "null"]
              }
            }
          },
          "affected_products": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "indicators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "display_value": {
                  "type": "string",
                  "description": "Defanged, for display only."
                },
                "confidence": {
                  "type": "integer"
                }
              }
            }
          },
          "attack_techniques": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tlp": {
            "type": "string",
            "enum": ["clear", "green", "amber", "amber+strict", "red"]
          },
          "tlp_source": {
            "type": "string",
            "enum": ["provided", "default"]
          }
        }
      },
      "Normalisation": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": ["string", "integer"]
                  }
                },
                "from": {},
                "to": {}
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemError": {
        "type": "object",
        "required": ["index", "document", "issues"],
        "properties": {
          "index": {
            "type": "integer",
            "description": "Position among the items produced from the request."
          },
          "document": {
            "type": "integer",
            "description": "Position of the source document in the request."
          },
          "source_ref": {
            "type": "string",
            "description": "STIX id, CSAF tracking id or OSV id."
          },
          "external_id": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "message"],
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": ["string", "integer"]
                  }
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "StoredResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["created", "updated", "unchanged"]
          },
          "revision": {
            "type": "integer"
          },
          "item": {
            "$ref": "#/components/schemas/NormalisedItem"
          },
          "normalisation": {
            "$ref": "#/components/schemas/Normalisation"
          }
        }
      },
      "StoredItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "const": "item"
          },
          "revision": {
            "type": "integer"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "stored_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_ingest_id": {
            "type": "string"
          },
          "item": {
            "$ref": "#/components/schemas/NormalisedItem"
          },
          "normalisation": {
            "$ref": "#/components/schemas/Normalisation"
          },
          "raw": {
            "description": "The original payload as received."
          }
        }
      },
      "BatchAccepted": {
        "type": "object",
        "properties": {
          "ingest_id": {
            "type": "string"
          },
          "status": {
            "const": "queued"
          },
          "status_url": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "received": {
            "type": "integer"
          },
          "accepted": {
            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "deduplicated": {
            "type": "integer",
            "description": "Items repeated within this request."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemError"
            }
          }
        }
      },
      "BatchStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "const": "batch"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "complete", "failed"]
          },
          "received": {
            "type": "integer"
          },
          "accepted": {
            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "deduplicated": {
            "type": "integer"
          },
          "created": {
            "type": "integer"
          },
          "updated": {
            "type": "integer"
          },
          "unchanged": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemError"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
