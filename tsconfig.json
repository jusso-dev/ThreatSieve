{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "workers/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "apps/web", "tests/e2e"]
}
